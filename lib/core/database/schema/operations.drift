-- Reminders, daily closings, audit trail, backup history and app settings.

import '../converters.dart';
import '../../domain/ledger_enums.dart';
import 'parties.drift';
import 'ledger.drift';
import 'money.drift';

CREATE TABLE reminders (
  id TEXT PRIMARY KEY NOT NULL,
  shop_id TEXT NOT NULL REFERENCES shops(id) ON DELETE RESTRICT,
  party_id TEXT REFERENCES parties(id) ON DELETE RESTRICT,
  source_ledger_entry_id TEXT,
  reminder_type TEXT NOT NULL CHECK(reminder_type IN ('customer_due','supplier_due','backup'))
    MAPPED BY `const CodedEnumConverter<ReminderType>(ReminderType.values)`,
  scheduled_at INTEGER NOT NULL MAPPED BY `const EpochMsConverter()`,
  notification_id INTEGER NOT NULL,
  -- No 'delivered' status: opening the share sheet proves nothing (ADR-012).
  status TEXT NOT NULL
    CHECK(status IN ('scheduled','cancelled','triggered','share_sheet_opened'))
    MAPPED BY `const CodedEnumConverter<ReminderStatus>(ReminderStatus.values)`,
  created_at INTEGER NOT NULL MAPPED BY `const EpochMsConverter()`,
  updated_at INTEGER NOT NULL MAPPED BY `const EpochMsConverter()`,
  FOREIGN KEY(party_id, shop_id) REFERENCES parties(id, shop_id) ON DELETE RESTRICT,
  FOREIGN KEY(source_ledger_entry_id, shop_id) REFERENCES party_ledger_entries(id, shop_id) ON DELETE RESTRICT
);

-- An immutable snapshot of expected vs counted cash. Re-closing a day adds a
-- new revision that supersedes the previous one. A count never posts to the
-- cash book (ADR-014).
CREATE TABLE daily_closings (
  id TEXT PRIMARY KEY NOT NULL,
  shop_id TEXT NOT NULL REFERENCES shops(id) ON DELETE RESTRICT,
  money_account_id TEXT NOT NULL REFERENCES money_accounts(id) ON DELETE RESTRICT,
  business_date TEXT NOT NULL CHECK(length(business_date) = 10),
  expected_cash_paise INTEGER NOT NULL,
  counted_cash_paise INTEGER NOT NULL CHECK(counted_cash_paise >= 0),
  variance_paise INTEGER NOT NULL,
  denomination_counts_json TEXT NOT NULL,
  note TEXT,
  revision_number INTEGER NOT NULL CHECK(revision_number > 0),
  supersedes_closing_id TEXT REFERENCES daily_closings(id) ON DELETE RESTRICT,
  created_at INTEGER NOT NULL MAPPED BY `const EpochMsConverter()`,
  UNIQUE(money_account_id, business_date, revision_number),
  FOREIGN KEY(money_account_id, shop_id) REFERENCES money_accounts(id, shop_id) ON DELETE RESTRICT
);

-- Why a correction or adjustment happened. metadata_json must not hold
-- secrets or unnecessary personal data.
CREATE TABLE audit_logs (
  id TEXT PRIMARY KEY NOT NULL,
  shop_id TEXT NOT NULL REFERENCES shops(id) ON DELETE RESTRICT,
  entity_type TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  "action" TEXT NOT NULL,
  reason TEXT,
  metadata_json TEXT,
  created_at INTEGER NOT NULL MAPPED BY `const EpochMsConverter()`
);

-- Metadata only: no passphrases, key material or raw file paths.
CREATE TABLE backup_history (
  id TEXT PRIMARY KEY NOT NULL,
  shop_id TEXT NOT NULL REFERENCES shops(id) ON DELETE RESTRICT,
  backup_id TEXT NOT NULL UNIQUE,
  schema_version INTEGER NOT NULL,
  app_version TEXT NOT NULL,
  created_at INTEGER NOT NULL MAPPED BY `const EpochMsConverter()`,
  record_counts_json TEXT NOT NULL,
  checksum_sha256 TEXT NOT NULL,
  destination_label TEXT,
  status TEXT NOT NULL CHECK(status IN ('created','verified','failed'))
    MAPPED BY `const CodedEnumConverter<BackupStatus>(BackupStatus.values)`,
  failure_code TEXT
);

-- Non-secret preferences only. PINs, passwords and keys never go here.
CREATE TABLE app_settings (
  "key" TEXT PRIMARY KEY NOT NULL,
  value TEXT NOT NULL,
  updated_at INTEGER NOT NULL MAPPED BY `const EpochMsConverter()`
);

CREATE INDEX reminders_status_schedule_idx ON reminders(shop_id, status, scheduled_at);
CREATE INDEX closings_account_date_idx ON daily_closings(money_account_id, business_date, revision_number DESC);
CREATE INDEX audit_entity_created_idx ON audit_logs(entity_type, entity_id, created_at DESC);

-- Added beyond schema_v1.sql (ADR-020): closing snapshots and the audit
-- trail are described as immutable, so the database enforces it.
CREATE TRIGGER daily_closings_no_update
BEFORE UPDATE ON daily_closings BEGIN
  SELECT RAISE(ABORT, 'daily_closings are append-only');
END;
CREATE TRIGGER daily_closings_no_delete
BEFORE DELETE ON daily_closings BEGIN
  SELECT RAISE(ABORT, 'daily_closings are append-only');
END;
CREATE TRIGGER audit_logs_no_update
BEFORE UPDATE ON audit_logs BEGIN
  SELECT RAISE(ABORT, 'audit_logs are append-only');
END;
CREATE TRIGGER audit_logs_no_delete
BEFORE DELETE ON audit_logs BEGIN
  SELECT RAISE(ABORT, 'audit_logs are append-only');
END;
